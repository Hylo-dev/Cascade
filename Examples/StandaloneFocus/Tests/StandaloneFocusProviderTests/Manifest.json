{
  "manifestVersion": 1,
  "id": "org.cascade.examples.focus",
  "version": "0.1.0",
  "compatibility": {
    "macOS": ">=14.0",
    "cascadeProtocol": {
      "major": 1,
      "minimumMinor": 0
    }
  },
  "execution": {
    "owner": "cascade",
    "activation": "onDemand",
    "entryPoint": "StandaloneFocusProvider"
  },
  "bundledLibraries": [],
  "REQUIRES": [],
  "PROVIDES": [],
  "features": [
    {
      "id": "focus.timer",
      "REQUIRES": [],
      "actions": [
        "start",
        "pause",
        "resume",
        "end"
      ]
    }
  ],
  "permissions": [
    {
      "id": "storage.own",
      "scope": "addon"
    }
  ],
  "resources": {
    "profile": "eventDriven",
    "requestedMemoryMiB": 16,
    "maximumConcurrentWork": 1,
    "background": "scheduledDeadline"
  }
}
