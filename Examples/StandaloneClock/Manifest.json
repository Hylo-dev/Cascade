{
  "manifestVersion": 1,
  "id": "org.cascade.examples.clock",
  "version": "0.1.0",
  "compatibility": {
    "macOS": ">=14.0",
    "cascadeProtocol": {
      "major": 1,
      "minimumMinor": 0
    }
  },
  "execution": {
    "owner": "cascade",
    "activation": "onDemand",
    "entryPoint": "StandaloneClockProvider"
  },
  "bundledLibraries": [],
  "REQUIRES": [],
  "PROVIDES": [],
  "features": [
    {
      "id": "clock",
      "REQUIRES": [],
      "actions": []
    }
  ],
  "permissions": [],
  "resources": {
    "profile": "eventDriven",
    "requestedMemoryMiB": 16,
    "maximumConcurrentWork": 1,
    "background": "none"
  }
}
