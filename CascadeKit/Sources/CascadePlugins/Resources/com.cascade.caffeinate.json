{
  "manifestVersion": 2,
  "id": "com.cascade.caffeinate",
  "version": "1.0.0",
  "compatibility": { "macOS": "15.0", "cascadeProtocol": { "major": 2, "minimumMinor": 0 } },
  "execution": { "entryPoint": "CaffeinatePlugin" },
  "features": [
    {
      "id": "awake",
      "supportsFullscreen": true,
      "surfaces": { "widget": { "sizes": ["2x2", "2x1", "1x1"] }, "activity": {} },
      "sources": ["caffeinate"],
      "permissions": ["power.keepAwake"],
      "actions": ["caffeinate.start", "caffeinate.stop", "caffeinate.duration.up", "caffeinate.duration.down", "caffeinate.display", "caffeinate.options"]
    }
  ],
  "resources": { "profile": "eventDriven" }
}
