{
  "manifestVersion": 2,
  "id": "com.cascade.caffeinate",
  "version": "1.0.0",
  "compatibility": { "macOS": "15.0", "cascadeProtocol": { "major": 2, "minimumMinor": 0 } },
  "execution": { "entryPoint": "CaffeinatePlugin" },
  "features": [
    {
      "id": "awake",
      "supportsFullscreen": true,
      "surfaces": { "widget": { "sizes": ["2x1", "1x1"] } },
      "sources": ["caffeinate"],
      "permissions": ["power.keepAwake"],
      "actions": ["caffeinate.toggle", "caffeinate.options", "caffeinate.duration.0", "caffeinate.duration.15", "caffeinate.duration.30", "caffeinate.duration.60", "caffeinate.duration.120", "caffeinate.duration.240", "caffeinate.duration.480", "caffeinate.display"]
    }
  ],
  "resources": { "profile": "eventDriven" }
}
