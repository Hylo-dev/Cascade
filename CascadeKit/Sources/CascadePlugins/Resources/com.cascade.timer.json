{
  "manifestVersion": 2,
  "id": "com.cascade.timer",
  "version": "1.0.0",
  "compatibility": { "macOS": "15.0", "cascadeProtocol": { "major": 2, "minimumMinor": 0 } },
  "execution": { "entryPoint": "TimerPlugin" },
  "features": [
    {
      "id": "timer",
      "surfaces": { "widget": { "sizes": ["1x1", "2x1", "2x2"] } },
      "actions": ["add1", "add5", "start", "pause", "reset"]
    },
    { "id": "finished", "surfaces": { "notice": {} } }
  ],
  "resources": { "profile": "eventDriven" }
}
