{
  "sourceLanguage": "en",
  "strings": {
    "Caffeinate": {
      "comment": "Name of the keep-awake widget and the title of its options page and activity.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Caffeinate" } } }
    },
    "Caffeinate Options": {
      "comment": "Accessibility label of the widget text that opens its options page.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Opzioni di Caffeinate" } } }
    },
    "Start Caffeinate": {
      "comment": "Accessibility label of the switch that starts a keep-awake session.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Avvia Caffeinate" } } }
    },
    "Stop Caffeinate": {
      "comment": "Accessibility label of the switch that stops the keep-awake session.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Ferma Caffeinate" } } }
    },
    "Add 15 minutes": {
      "comment": "Accessibility label of the button that extends a session by fifteen minutes.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Aggiungi 15 minuti" } } }
    },
    "Shorter": {
      "comment": "Accessibility label of the stepper button that picks a shorter duration.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Più breve" } } }
    },
    "Longer": {
      "comment": "Accessibility label of the stepper button that picks a longer duration.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Più lunga" } } }
    },
    "Start": {
      "comment": "Pill that starts a keep-awake session.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Avvia" } } }
    },
    "Stop": {
      "comment": "Pill that stops the keep-awake session.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Ferma" } } }
    },
    "Your Mac sleeps normally": {
      "comment": "Options page status while no session runs.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Il Mac va in stop normalmente" } } }
    },
    "Awake until you stop it": {
      "comment": "Options page status for a session without a time limit.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Sveglio finché non lo fermi" } } }
    },
    "Keep display awake": {
      "comment": "Switch that also keeps the display from sleeping.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Schermo acceso" } } }
    },
    "until": {
      "comment": "Small label before the time a timed session ends.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "fino alle" } } }
    },
    "active for": {
      "comment": "Small label above the elapsed time of a session without a time limit.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "attivo da" } } }
    },
    "Couldn't prevent sleep (error %@)": {
      "comment": "Options page line when the system refused to keep the Mac awake. %@ is the system's error code, written without digit grouping.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Impossibile impedire lo stop (errore %@)" } } }
    },
    "Caffeinate, awake until %@": {
      "comment": "Spoken sentence of the live activity of a timed session. %@ is the time the session ends.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Caffeinate, sveglio fino alle %@" } } }
    },
    "Caffeinate, awake until you stop it": {
      "comment": "Spoken sentence of the live activity of a session without a time limit.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Caffeinate, sveglio finché non lo fermi" } } }
    },
    "Awake until": {
      "comment": "Options page status of a timed session, followed by the time the session ends, which the kernel draws.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Sveglio fino alle" } } }
    },
    "Error": {
      "comment": "Widget tile line when the system refused to keep the Mac awake; the options page has the sentence and the code.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Errore" } } }
    },
    "Couldn't extend (error %@)": {
      "comment": "Options page line when the system refused to lengthen a running session. %@ is the system's error code.",
      "localizations": { "it": { "stringUnit": { "state": "translated", "value": "Impossibile estendere (errore %@)" } } }
    }
  },
  "version": "1.0"
}
