{
  "sourceLanguage": "en",
  "strings": {
    "%@, battery %lld percent": {
      "comment": "Accessibility description of a device in the devices widget. %@ is the device name, %lld its charge from 0 to 100.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, batteria al %2$lld percento"
          }
        }
      }
    },
    "Add five minutes": {
      "comment": "Accessibility label of the timer widget's button that adds five minutes.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi cinque minuti"
          }
        }
      }
    },
    "Add one minute": {
      "comment": "Accessibility label of the timer widget's button that adds one minute.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un minuto"
          }
        }
      }
    },
    "Battery": {
      "comment": "Settings name of the battery widget plugin.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteria"
          }
        }
      }
    },
    "Bluetooth alerts": {
      "comment": "Settings name of the Bluetooth notice plugin.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisi Bluetooth"
          }
        }
      }
    },
    "Bluetooth is off": {
      "comment": "Devices widget text when Bluetooth does not work on this Mac.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth spento"
          }
        }
      }
    },
