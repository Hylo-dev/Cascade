{
  "manifestVersion": 2,
  "id": "com.cascade.devices",
  "version": "1.0.0",
  "compatibility": { "macOS": "15.0", "cascadeProtocol": { "major": 2, "minimumMinor": 0 } },
  "execution": { "entryPoint": "DevicesPlugin" },
  "features": [
    {
      "id": "devices",
      "surfaces": { "widget": { "sizes": ["2x1", "2x2"] } },
      "sources": ["bluetooth"],
      "components": [{ "id": "bluetooth.battery", "version": 1 }]
    }
  ],
  "resources": { "profile": "eventDriven" }
}
