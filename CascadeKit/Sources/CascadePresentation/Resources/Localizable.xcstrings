{
  "sourceLanguage": "en",
  "strings": {
    "%lld more files": {
      "comment": "Shelf: accessibility label of the count of files beyond the deck.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more file"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more files"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Altro %lld file"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Altri %lld file"
                }
              }
            }
          }
        }
      }
    },
    "Available": {
      "comment": "Shelf: availability of a file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile"
          }
        }
      }
    },
    "Back to Shelf": {
      "comment": "Shelf: button that closes the file list and returns to the deck.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna al ripiano"
          }
        }
      }
    },
    "clear": {
      "comment": "Shelf: lowercase caption under the clear icon; removes every file from the shelf.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "svuota"
          }
        }
      }
    },
    "convert": {
      "comment": "Shelf: lowercase caption under the convert icon.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "converti"
          }
        }
      }
    },
    "Load More Files": {
      "comment": "Shelf: button that loads the next page of files.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica altri file"
          }
        }
      }
    },
    "Open File List": {
      "comment": "Shelf: accessibility label of the file deck, which opens the list.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri elenco file"
          }
        }
      }
    },
    "Quick Look": {
      "comment": "Shelf: context menu item that previews the file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima"
          }
        }
      }
    },
    "Receiving": {
      "comment": "Shelf: availability of a file still being received.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ricezione"
          }
        }
      }
    },
    "Relink": {
      "comment": "Shelf: context menu item that lets the user locate a moved file again.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricollega"
          }
        }
      }
    },
    "Remove": {
      "comment": "Shelf: context menu item that removes the file from the shelf, not from disk.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi"
          }
        }
      }
    },
    "Remove all files from the shelf": {
      "comment": "Shelf: help tag of the clear button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi tutti i file dal ripiano"
          }
        }
      }
    },
    "rename": {
      "comment": "Shelf: lowercase caption under the rename icon.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "rinomina"
          }
        }
      }
    },
    "Rename the selected file": {
      "comment": "Shelf: help tag of the rename button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina il file selezionato"
          }
        }
      }
    },
    "Selected": {
      "comment": "Shelf: accessibility label of a selected file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionato"
          }
        }
      }
    },
    "Show in Finder": {
      "comment": "Shelf: context menu item.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "The original files stay where they are": {
      "comment": "Shelf: accessibility hint of the clear button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file originali restano al loro posto"
          }
        }
      }
    },
    "Unavailable": {
      "comment": "Shelf: availability of a file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile"
          }
        }
      }
    }
  },
  "version": "1.0"
}
