{
  "sourceLanguage": "en",
  "strings": {
    "%lld more files": {
      "comment": "Shelf: accessibility label of the count of files beyond the deck.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more file"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more files"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Altro %lld file"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Altri %lld file"
                }
              }
            }
          }
        }
      }
    },
    "%lld results available": {},
    "+%lld": {},
    "+%lld more inputs": {},
    "+%lld more results": {},
    "Add Widget": {
      "comment": "Button in the widget gallery that adds the widget at its first size.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi widget"
          }
        }
      }
    },
    "Add Widget, Size %lld of %lld": {
      "comment": "Accessibility label of a widget gallery size button: which of the widget's sizes it adds.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi widget, dimensione %1$lld di %2$lld"
          }
        }
      }
    },
    "Adjust Notch Size": {
      "comment": "Window title of the notch size calibration panel.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola dimensioni del notch"
          }
        }
      }
    },
    "Adjust the notch base": {
      "comment": "Title of the notch size calibration overlay.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la base del notch"
          }
        }
      }
    },
    "Allow audio capture in System Settings": {
      "comment": "Audio mixer: one-line banner, also a button, shown when the system refused audio capture.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la registrazione audio nelle Impostazioni di Sistema"
          }
        }
      }
    },
    "Apps appear here when they play audio": {
      "comment": "Mixer: empty state of the area that will list the apps playing audio.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app compaiono qui quando riproducono audio"
          }
        }
      }
    },
    "Audio": {
      "comment": "Title of the audio mixer page, beside the level.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        }
      }
    },
    "Audio output": {
      "comment": "Accessibility label of the audio output button and of its selector.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscita audio"
          }
        }
      }
    },
    "Available": {
      "comment": "Shelf: availability of a file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile"
          }
        }
      }
    },
    "Back": {
      "comment": "Accessibility label of the button that closes a plugin's detail page.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indietro"
          }
        }
      }
    },
    "Back to Shelf": {
      "comment": "Shelf: button that closes the file list and returns to the deck.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna al ripiano"
          }
        }
      }
    },
    "Cancel": {},
    "Cancel Adjustment": {
      "comment": "Accessibility label of the calibration cancel button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla regolazione"
          }
        }
      }
    },
    "Cancel · Esc": {
      "comment": "Calibration button that discards the adjustment; Esc is its key.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla · Esc"
          }
        }
      }
    },
    "Cascade Settings": {
      "comment": "Accessibility description of the settings button in the expanded notch.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di Cascade"
          }
        }
      }
    },
    "Choose a format": {},
    "clear": {
      "comment": "Shelf: lowercase caption under the clear icon; removes every file from the shelf.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "svuota"
          }
        }
      }
    },
    "Conversion in progress": {},
    "Conversion progress": {},
    "convert": {
      "comment": "Shelf: lowercase caption under the convert icon.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "converti"
          }
        }
      }
    },
    "Decrease Height": {
      "comment": "Accessibility label of the calibration button that makes the notch shorter.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci altezza"
          }
        }
      }
    },
    "Decrease Width": {
      "comment": "Accessibility label of the calibration button that narrows the notch.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci larghezza"
          }
        }
      }
    },
    "Done": {
      "comment": "Button that ends widget editing on the notch.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine"
          }
        }
      }
    },
    "Edit Widgets": {
      "comment": "Accessibility action on a notch widget that starts widget editing.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica widget"
          }
        }
      }
    },
    "Every widget is on the notch.": {
      "comment": "Shown in the widget gallery when no widget is left to add.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i widget sono nel notch."
          }
        }
      }
    },
    "Expand activity": {
      "comment": "Accessibility hint of a compact activity in the notch.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espandi attività"
          }
        }
      }
    },
    "Follow system": {
      "comment": "Audio mixer: first row of an app's output selector; the app plays to whatever the system output is.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui sistema"
          }
        }
      }
    },
    "Global volume": {
      "comment": "Accessibility label of the mixer's system volume capsule.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume globale"
          }
        }
      }
    },
    "Hidden Activity": {
      "comment": "Placeholder shown instead of a sensitive activity's content.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività nascosta"
          }
        }
      }
    },
    "Hidden sensitive activity": {
      "comment": "Accessibility label of the sensitive activity placeholder.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività sensibile nascosta"
          }
        }
      }
    },
    "Increase Height": {
      "comment": "Accessibility label of the calibration button that makes the notch taller.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta altezza"
          }
        }
      }
    },
    "Increase Width": {
      "comment": "Accessibility label of the calibration button that widens the notch.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta larghezza"
          }
        }
      }
    },
    "Inputs": {},
    "Load More Files": {
      "comment": "Shelf: button that loads the next page of files.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica altri file"
          }
        }
      }
    },
    "Mute": {
      "comment": "Accessibility label of the button that mutes the system audio.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenzia"
          }
        }
      }
    },
    "No formats": {},
    "Not applied": {
      "comment": "Accessibility value of an app column whose volume request cannot be enforced.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non applicato"
          }
        }
      }
    },
    "Open": {
      "comment": "Button that opens the app behind an activity.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri"
          }
        }
      }
    },
    "Open File List": {
      "comment": "Shelf: accessibility label of the file deck, which opens the list.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri elenco file"
          }
        }
      }
    },
    "Preview result format: %@": {},
    "Preview results": {},
    "Quick Look": {
      "comment": "Shelf: context menu item that previews the file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima"
          }
        }
      }
    },
    "Receiving": {
      "comment": "Shelf: availability of a file still being received.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ricezione"
          }
        }
      }
    },
    "Recovering": {
      "comment": "Accessibility value of an app column whose audio is being rebuilt.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino in corso"
          }
        }
      }
    },
    "Relink": {
      "comment": "Shelf: context menu item that lets the user locate a moved file again.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricollega"
          }
        }
      }
    },
    "Remove": {
      "comment": "Shelf: context menu item that removes the file from the shelf, not from disk.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi"
          }
        }
      }
    },
    "Remove all files from the shelf": {
      "comment": "Shelf: help tag of the clear button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi tutti i file dal ripiano"
          }
        }
      }
    },
    "Remove Widget": {
      "comment": "Button on a notch widget while editing that takes it off the grid.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi widget"
          }
        }
      }
    },
    "rename": {
      "comment": "Shelf: lowercase caption under the rename icon.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "rinomina"
          }
        }
      }
    },
    "Rename the selected file": {
      "comment": "Shelf: help tag of the rename button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina il file selezionato"
          }
        }
      }
    },
    "Resize Widget": {
      "comment": "Button on a notch widget while editing that switches it to its next size.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona widget"
          }
        }
      }
    },
    "Results": {},
    "Return to native audio": {
      "comment": "Audio mixer: context menu item that forgets the volume set for an app.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna all'audio nativo"
          }
        }
      }
    },
    "Save Size": {
      "comment": "Accessibility label of the calibration save button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva dimensioni"
          }
        }
      }
    },
    "Save · Return": {
      "comment": "Calibration button that saves the size; Return is its key.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva · Invio"
          }
        }
      }
    },
    "Selected": {
      "comment": "Shelf: accessibility label of a selected file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionato"
          }
        }
      }
    },
    "Sensitive content hidden": {
      "comment": "Placeholder and accessibility label shown instead of a widget whose content is marked sensitive.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuto sensibile nascosto"
          }
        }
      }
    },
    "Settings…": {
      "comment": "Tooltip of the settings button in the expanded notch.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni…"
          }
        }
      }
    },
    "Several outputs": {
      "comment": "Switch in the audio output selector: lets the user play to several outputs at once.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più uscite"
          }
        }
      }
    },
    "Show in Finder": {
      "comment": "Shelf: context menu item.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "Start": {},
    "The original files stay where they are": {
      "comment": "Shelf: accessibility hint of the clear button.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file originali restano al loro posto"
          }
        }
      }
    },
    "Unavailable": {
      "comment": "Shelf: availability of a file.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile"
          }
        }
      }
    },
    "Unmute": {
      "comment": "Accessibility label of the button that unmutes the system audio.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riattiva audio"
          }
        }
      }
    },
    "Update delayed": {
      "comment": "Accessibility label of the badge shown when an activity's content is stale.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento in ritardo"
          }
        }
      }
    },
    "Width %lld pt   ×   Height %lld pt": {
      "comment": "Current notch size in the calibration overlay, in points.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza %lld pt   ×   Altezza %lld pt"
          }
        }
      }
    },
    "← → Width   ·   ↑ ↓ Height   ·   Shift: 5 pt": {
      "comment": "Keyboard help in the calibration overlay; Shift moves 5 points at a time.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "← → Larghezza   ·   ↑ ↓ Altezza   ·   Maiusc: 5 pt"
          }
        }
      }
    }
  },
  "version": "1.0"
}
