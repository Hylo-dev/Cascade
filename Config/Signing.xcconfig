// Signing.xcconfig is the project-wide signing base for every target.
//
// A fresh clone signs ad hoc ("Sign to Run Locally"), so it builds and runs
// with no Apple account and no team. The trade-off is TCC: an ad-hoc
// signature is bound to one cdhash, so macOS forgets the Accessibility and
// Automation grants after every rebuild and asks again.
//
// To keep those grants stable, sign with your own team instead: copy
// Signing.local.xcconfig.example to Signing.local.xcconfig and set your team
// ID. That file is gitignored, so two developers never overwrite each other's
// team in the shared project file again.

CODE_SIGN_STYLE    = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM   =

#include? "Signing.local.xcconfig"
