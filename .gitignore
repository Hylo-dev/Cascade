# ─── macOS ──────────────────────────────────────────────────────────
.DS_Store

# ─── Xcode ──────────────────────────────────────────────────────────
# Build products and per-user state — regenerable or machine-specific.
build/
DerivedData/
Config/FFmpeg/Artifacts/
Config/FFmpeg/Build/
Config/FFmpeg/Downloads/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
# Per-user Xcode data: schemes management, breakpoints, window layout.
# Matches Cascade.xcodeproj/xcuserdata and Cascade.xcworkspace/xcuserdata.
xcuserdata/

# ─── Swift Package Manager ─────────────────────────────────────────
# SwiftPM build output (e.g. CascadeKit/.build) and local package state —
# this is the "merda" that must never be committed.
.build/
.swiftpm/

# ─── Misc ───────────────────────────────────────────────────────────
*.swp
*~

# Temporary pipeline scratch stays out of Git, but the canonical local tracker
# under .scratch/cascade-product remains visible for review.
.scratch/*
!.scratch/cascade-product/

# Generated profiling data and Python bytecode
*.profraw
__pycache__/
